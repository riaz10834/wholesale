# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose. Used to create delivery person accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud -> APIs: Maps JavaScript API, Directions API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Store settings
NEXT_PUBLIC_STORE_NAME=WholesaleHub
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_DEFAULT_LAT=24.8607
NEXT_PUBLIC_DEFAULT_LNG=67.0011
